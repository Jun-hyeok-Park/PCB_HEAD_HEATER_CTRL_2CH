# ============================================
# Vendor downloaded LIB_* packages
# Keep ONLY Altium libraries + STEP models
# ============================================

/LIB_*/**

# Allow directory traversal
!/LIB_*/**/

# Altium libraries
!/LIB_*/**/*.SchLib
!/LIB_*/**/*.PcbLib
!/LIB_*/**/*.IntLib

# STEP / STP 3D models
!/LIB_*/**/*.STEP
!/LIB_*/**/*.STP
!/LIB_*/**/*.step
!/LIB_*/**/*.stp
